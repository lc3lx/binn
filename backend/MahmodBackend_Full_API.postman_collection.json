    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get notifications for logged user.",
            "url": "{{baseUrl}}/api/v1/notifications/me"
          }
        },
        {
          "name": "Mark One Notification Read",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Mark one notification as read.",
            "url": "{{baseUrl}}/api/v1/notifications/me/{{notificationId}}/read"
          }
