{
  "info": {
    "_postman_id": "b3184ad3-0e72-4f26-9a1d-7994d6427c7a",
    "name": "Mahmod Backend Full API",
    "description": "Complete Postman collection for all APIs in the backend.\\n\\nHow to use:\\n1) Set `baseUrl` to your server (default: http://localhost:8000).\\n2) Run Auth login/signup and copy token to `token` variable (raw JWT only).\\n3) Use returned ids and fill variables: userId, planId, transactionId, ticketId, faqId, notificationId, orderId.\\n\\nNotes:\\n- Endpoints under admin routes require admin/manager role token.\\n- Protected endpoints require header Authorization: Bearer {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "faqId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Create new user account and return JWT token. `referralCode` is optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\",\n  \"passwordConfirm\": \"123456\",\n  \"referralCode\": \"ABC12345\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Login user and return JWT token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Login/register with Google ID token. `referralCode` is optional (works for first-time signup).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"GOOGLE_ID_TOKEN\",\n  \"referralCode\": \"ABC12345\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/google"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Send password reset code to user email.",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgotPassword"
          }
        },
        {
          "name": "Verify Reset Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Verify reset code.",
            "body": { "mode": "raw", "raw": "{\n  \"resetCode\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/verifyResetCode"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Reset password after code verification.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"newPassword\": \"654321\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/resetPassword"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get logged-in user profile.",
            "url": "{{baseUrl}}/api/v1/users/getMe"
          }
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Update logged-in user data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User\",\n  \"email\": \"updated@example.com\",\n  \"phone\": \"+966500000000\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/updateMe"
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Change logged-in user password.",
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"newPassword123\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/changeMyPassword"
          }
        },
        {
          "name": "Submit KYC",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Upload front/back ID images for KYC verification with fullName and nationalNumber.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "type": "text", "value": "Mahmoud Ahmad" },
                { "key": "nationalNumber", "type": "text", "value": "12345678901" },
                { "key": "frontImage", "type": "file", "src": "" },
                { "key": "backImage", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/kyc/submit"
          }
        },
        {
          "name": "Delete Me",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Deactivate own account.",
            "url": "{{baseUrl}}/api/v1/users/deleteMe"
          }
        },
        {
          "name": "Admin - KYC Review",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Approve/reject user KYC request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"rejectionReason\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/kyc/{{userId}}/review"
          }
        },
        {
          "name": "Admin - KYC Requests List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "List KYC requests with filters: status=all|approved|pending|rejected, search, page, limit.",
            "url": "{{baseUrl}}/api/v1/users/admin/kyc-requests?status=all&page=1&limit=10"
          }
        },
        {
          "name": "Admin - Users Management List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Admin users table list with filters: status, kycStatus, search, page, limit.",
            "url": "{{baseUrl}}/api/v1/users/admin/list?status=active&page=1&limit=10"
          }
        },
        {
          "name": "Admin - User Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get full user details for admin side panel/page.",
            "url": "{{baseUrl}}/api/v1/users/admin/{{userId}}/details"
          }
        },
        {
          "name": "Admin - Block User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Block user account (active=false).",
            "url": "{{baseUrl}}/api/v1/users/admin/{{userId}}/block"
          }
        },
        {
          "name": "Admin - Unblock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Unblock user account (active=true).",
            "url": "{{baseUrl}}/api/v1/users/admin/{{userId}}/unblock"
          }
        },
        {
          "name": "Admin - Wallet Adjust",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Adjust user wallet manually from users management actions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"add\",\n  \"amount\": 100,\n  \"note\": \"manual admin action\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/admin/{{userId}}/wallet-adjust"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get current user wallet balance.",
            "url": "{{baseUrl}}/api/v1/wallet/me"
          }
        },
        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get current user wallet transactions.",
            "url": "{{baseUrl}}/api/v1/wallet/me/transactions"
          }
        },
        {
          "name": "Request Deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Create deposit request (pending review).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000,\n  \"walletAddress\": \"TRX7a8b9c...d4e5\",\n  \"txHash\": \"0xabc...\",\n  \"note\": \"USDT TRC20 deposit\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/wallet/deposit/request"
          }
        },
        {
          "name": "Request Withdraw",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Create withdraw request (pending). Supports fee and walletAddress.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2500,\n  \"walletAddress\": \"TRX7a8b9c...d4e5\",\n  \"withdrawalFee\": 15,\n  \"note\": \"cash out\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/wallet/withdraw/request"
          }
        },
        {
          "name": "Admin - Deposits Management",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Deposits table with counters + filters (status/search/page/limit).",
            "url": "{{baseUrl}}/api/v1/wallet/admin/deposits?status=all&page=1&limit=10"
          }
        },
        {
          "name": "Admin - Review Deposit",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Confirm or reject pending deposit.",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}" },
            "url": "{{baseUrl}}/api/v1/wallet/deposits/{{transactionId}}/review"
          }
        },
        {
          "name": "Admin - Withdrawals Management",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Withdrawals table with counters + filters.",
            "url": "{{baseUrl}}/api/v1/wallet/admin/withdrawals?status=all&page=1&limit=10"
          }
        },
        {
          "name": "Admin - Review Withdrawal",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Approve or reject pending withdrawal.",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}" },
            "url": "{{baseUrl}}/api/v1/wallet/transactions/{{transactionId}}/review"
          }
        },
        {
          "name": "Admin - Mark Withdrawal Paid",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Mark approved withdrawal as paid.",
            "url": "{{baseUrl}}/api/v1/wallet/transactions/{{transactionId}}/mark-paid"
          }
        },
        {
          "name": "Admin - Notify Withdrawal Paid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Send notification after paid withdrawal (idempotent once).",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Your withdrawal has been paid.\"\n}" },
            "url": "{{baseUrl}}/api/v1/wallet/transactions/{{transactionId}}/notify-user"
          }
        },
        {
          "name": "Admin - Transactions Management",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Unified transactions table filters: type/status/search/pagination.",
            "url": "{{baseUrl}}/api/v1/wallet/admin/transactions?type=all&status=all&page=1&limit=10"
          }
        },
        {
          "name": "Admin - Create User Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Direct transaction injection by admin for a specific user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"deposit\",\n  \"amount\": 500,\n  \"note\": \"manual top-up\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/wallet/{{userId}}/transactions"
          }
        },
        {
          "name": "Admin - Get User Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get all wallet transactions for a specific user.",
            "url": "{{baseUrl}}/api/v1/wallet/{{userId}}/transactions"
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "description": "Public list of plans. Optional: activeOnly=true, search=plan name.",
            "url": "{{baseUrl}}/api/v1/plans?activeOnly=true"
          }
        },
        {
          "name": "Get Plan By Id",
          "request": {
            "method": "GET",
            "description": "Get one plan details by id.",
            "url": "{{baseUrl}}/api/v1/plans/{{planId}}"
          }
        },
        {
          "name": "Get My Subscriptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get logged user current plan + all subscriptions.",
            "url": "{{baseUrl}}/api/v1/plans/me/subscriptions"
          }
        },
        {
          "name": "Subscribe To Plan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Subscribe user to plan (supports multiple subscriptions).",
            "url": "{{baseUrl}}/api/v1/plans/{{planId}}/subscribe"
          }
        },
        {
          "name": "Admin - Plans Management",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Admin plans cards with subscribers stats + summary.",
            "url": "{{baseUrl}}/api/v1/plans/admin/management?status=all&search="
          }
        },
        {
          "name": "Admin - Create Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Create plan with pricing, ROI, hashrate, duration, and features.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Starter Miner\",\n  \"price\": 100,\n  \"currency\": \"USDT\",\n  \"hashrate\": 10,\n  \"hashrateUnit\": \"TH/s\",\n  \"roiMinPercent\": 30,\n  \"roiMaxPercent\": 42,\n  \"durationDays\": 30,\n  \"features\": [\"Daily payouts\", \"Instant activation\"],\n  \"isPopular\": false,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/plans"
          }
        },
        {
          "name": "Admin - Update Plan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Update existing plan fields.",
            "body": { "mode": "raw", "raw": "{\n  \"price\": 120,\n  \"isPopular\": true\n}" },
            "url": "{{baseUrl}}/api/v1/plans/{{planId}}"
          }
        },
        {
          "name": "Admin - Delete Plan",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Delete plan by id.",
            "url": "{{baseUrl}}/api/v1/plans/{{planId}}"
          }
        }
      ]
    },
    {
      "name": "Support",
      "item": [
        {
          "name": "Create Support Ticket",
